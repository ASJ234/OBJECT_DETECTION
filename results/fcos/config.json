{
  "model": {
    "name": "FCOS-ResNet50-FPN",
    "num_classes": 2,
    "image_min_size": 1024,
    "image_max_size": 1536
  },
  "training": {
    "epochs": 75,
    "batch_size": 8,
    "lr": 0.0001,
    "optimizer": "AdamW",
    "weight_decay": 0.0001,
    "momentum": 0.9,
    "clip_norm": 10.0,
    "warmup_epochs": 0,
    "ema_decay": 0.99,
    "early_stop_patience": 30,
    "save_every": 10,
    "seed": 42,
    "resume": "results/fcos/weights/last_checkpoint.pth",
    "push_to_hub": true
  },
  "augmentation": {
    "hflip_prob": 0.5,
    "brightness": 0.3,
    "contrast": 0.3,
    "gamma": 0.2,
    "noise_std": 0.05,
    "normalize": false
  },
  "data": {
    "train_images": "dataset/coco/train",
    "val_images": "dataset/coco/val",
    "train_ann": "dataset/coco/train.json",
    "val_ann": "dataset/coco/val.json",
    "test_images": "dataset/coco/test",
    "test_ann": "dataset/coco/test.json",
    "num_workers": 0
  },
  "results_dir": "results/fcos"
}